<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gentics.cmp</groupId>
		<artifactId>cmp</artifactId>
		<version>ci-devtest-SNAPSHOT</version>
	</parent>

	<artifactId>cmp-guides</artifactId>
	<packaging>pom</packaging>
	<description>Module for building the combined Guides</description>

	<dependencies>
		<!-- ANDP Guides -->
		<dependency>
			<groupId>com.gentics.andp</groupId>
			<artifactId>andp-guides</artifactId>
			<version>${andp.version}</version>
			<classifier>content</classifier>
			<type>zip</type>
		</dependency>
		<!-- Mesh Plugin Guides -->
		<dependency>
			<groupId>com.gentics.mesh.plugin</groupId>
			<artifactId>mesh-commercial-plugins-guides</artifactId>
			<version>${mesh.version}</version>
			<classifier>content</classifier>
			<type>zip</type>
		</dependency>
		<!-- Mesh Enterprise Plugin Guides -->
		<dependency>
			<groupId>com.gentics.mesh.plugin.enterprise</groupId>
			<artifactId>mesh-enterprise-plugins-guides</artifactId>
			<version>${mesh.version}</version>
			<classifier>content</classifier>
			<type>zip</type>
		</dependency>
		<!-- Mesh Portal | Java -->
		<dependency>
			<groupId>com.gentics.mesh.portal</groupId>
			<artifactId>mesh-portal-docs</artifactId>
			<version>${portals.version}</version>
			<classifier>content</classifier>
			<type>zip</type>
		</dependency>
		<!-- Mesh Portal | php -->
		<dependency>
			<groupId>com.gentics.mesh.portal-php</groupId>
			<artifactId>mesh-portal-php-docs</artifactId>
			<version>${portals.version}</version>
			<classifier>content</classifier>
			<type>zip</type>
		</dependency>
		<!-- Mesh Guides, currently only used for openapi.yaml and Plugin guides -->
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>mesh-doc</artifactId>
			<version>${mesh.version}</version>
			<classifier>src</classifier>
			<type>zip</type>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- CMS OSS Server, currently used for extracting openapi.yaml -->
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-oss-server</artifactId>
			<version>${cms.version}</version>
			<type>jar</type>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- CMS EE Server, currently used for extracting openapi.yaml -->
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-server</artifactId>
			<version>${cms.version}</version>
			<type>jar</type>
			<exclusions>
				<exclusion>
					<groupId>*</groupId>
					<artifactId>*</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-resources-src</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/src</outputDirectory>
							<resources>          
								<resource>
									<directory>src</directory>
									<filtering>false</filtering>
								</resource>
							</resources>              
						</configuration>            
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<version>3.3.1</version>
				<executions>
					<execution>
						<id>copy-resources-build</id>
						<phase>process-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${project.build.directory}/build</outputDirectory>
							<resources>          
								<resource>
									<directory>build</directory>
									<filtering>false</filtering>
								</resource>
							</resources>              
						</configuration>            
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>unpack-guides</id>
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<!-- ANDP -->
								<artifactItem>
									<groupId>com.gentics.andp</groupId>
									<artifactId>andp-guides</artifactId>
									<type>zip</type>
									<classifier>content</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/src/main/hugo/content</outputDirectory>
								</artifactItem>
								<!-- Mesh Plugins -->
								<artifactItem>
									<groupId>com.gentics.mesh.plugin</groupId>
									<artifactId>mesh-commercial-plugins-guides</artifactId>
									<type>zip</type>
									<classifier>content</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/src/main/hugo/content</outputDirectory>
								</artifactItem>
								<!-- Mesh Enterprise Plugins -->
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.enterprise</groupId>
									<artifactId>mesh-enterprise-plugins-guides</artifactId>
									<type>zip</type>
									<classifier>content</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/src/main/hugo/content</outputDirectory>
								</artifactItem>
								<!-- Mesh Portal | Java -->
								<artifactItem>
									<groupId>com.gentics.mesh.portal</groupId>
									<artifactId>mesh-portal-docs</artifactId>
									<classifier>content</classifier>
									<type>zip</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/src/main/hugo/content</outputDirectory>
								</artifactItem>
								<!-- Mesh Portal | php -->
								<artifactItem>
									<groupId>com.gentics.mesh.portal-php</groupId>
									<artifactId>mesh-portal-php-docs</artifactId>
									<classifier>content</classifier>
									<type>zip</type>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/src/main/hugo/content</outputDirectory>
								</artifactItem>
								<!-- Mesh Guides -->
								<artifactItem>
									<groupId>com.gentics.mesh</groupId>
									<artifactId>mesh-doc</artifactId>
									<classifier>src</classifier>
									<type>zip</type>
									<overWrite>true</overWrite>
									<includes>docs/generated/api/openapi.yaml</includes>
									<outputDirectory>${project.build.directory}/src/main/hugo/content/mesh</outputDirectory>
									<fileMappers>
										<org.codehaus.plexus.components.io.filemappers.FlattenFileMapper />
									</fileMappers>
								</artifactItem>
								<!-- CMS -->
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-oss-server</artifactId>
									<type>jar</type>
									<overWrite>true</overWrite>
									<includes>webroot/openapi/openapi.yaml</includes>
									<outputDirectory>${project.build.directory}/src/main/hugo/content/cms-oss</outputDirectory>
									<fileMappers>
										<org.codehaus.plexus.components.io.filemappers.FlattenFileMapper />
									</fileMappers>
								</artifactItem>
								<!-- CMS EE -->
								<artifactItem>
									<groupId>com.gentics.cms</groupId>
									<artifactId>cms-server</artifactId>
									<type>jar</type>
									<overWrite>true</overWrite>
									<includes>webroot/openapi/openapi.yaml</includes>
									<outputDirectory>${project.build.directory}/src/main/hugo/content/cms-ee</outputDirectory>
									<fileMappers>
										<org.codehaus.plexus.components.io.filemappers.FlattenFileMapper />
									</fileMappers>
								</artifactItem>
							</artifactItems>
							<includes>**/*</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>1.5.0</version>
				<executions>
					<execution>
						<id>Generate HTML</id>
						<goals>
							<goal>exec</goal>
						</goals>
						<phase>prepare-package</phase>
						<configuration>
							<executable>bash</executable>
							<arguments>
								<argument>${project.build.directory}/build/dockerBuild.sh</argument>
								<argument>${project.version}</argument>
							</arguments>
							<skip>${skip.doc.package}</skip>
							<successCodes>0,255</successCodes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>dist</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<attach>true</attach>
							<appendAssemblyId>false</appendAssemblyId>
							<descriptors>
								<descriptor>${project.basedir}/src/assembly/guides-site-package.xml</descriptor>
							</descriptors>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
