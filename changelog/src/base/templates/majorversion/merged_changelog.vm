#set($changelog = $changelogsSubset.get(0))

#set($version = "$changelog.getVersion()")
#set($shortVersion = $version.substring(0, $version.lastIndexOf(".")))
#set($pageTitle = "$changelogTitle $shortVersion Changelog Summary")
<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Gentics CMP Changelog. View all changes and bugfixes delivered by Version $changelog.getVersion()" />
  <meta http-equiv="cache-control" content="no-store, no-cache, must-revalidate, post-check=0, pre-check=0">
  <title>$pageTitle</title>

  <!-- Common Styles: Colors, Fonts, Header, Footer -->
  <link rel="stylesheet" href="https://www.gentics.com/static/css/common.css" />


  <!-- Changelog Specific Styles -->
  <link rel="stylesheet" href="../static/css/changelog.css" />
</head>

<body>
 
   #parse("partials/header.vm")

  <section class="hero-small">
    <div class="container">
      <h1>$pageTitle</h1>
    </div>
  </section>

  #parse("partials/mainnav.vm")

  #set($version = "$changelog.getVersion()")
  #set($shortVersion = $version.substring(0, $version.lastIndexOf(".")))
  <div id="nav-currentversion-submenu" data-majorversion="${shortVersion}">
    <ul class="nav-submenu"> 
       #foreach($subversion in $changelogsSubset)
          <li class="nav-item  #if("$changelog.getVersion()" == "$subversion.version") active #end">
            <a href="./${subversion.version}.html" class="nav-link">
                $changelogTitle $subversion.version
            </a>
          </li>
        #end
    </ul>

  </div>

	
<!-- Main Layout Wrapper -->
  <div class="layout-wrapper">
    <!-- Hero Section -->
    <div class="main-content">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/infoportal" class="breadcrumb-link">
              Infoportal
            </a>
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <a href="/cmp/changelog" class="breadcrumb-link">CMP Changelogs</a>
          </li>
          <li class="breadcrumb-item">
            #set($version = "$changelog.getVersion()")
            #set($shortVersion = $version.substring(0, $version.lastIndexOf(".")))
            <a href="../${shortVersion}.0" class="breadcrumb-link">$changelogTitle $shortVersion</a>
          </li>
        </ol>
      </nav>	

      <!-- Main Content -->
      <main id="main-content">

        <ul class="toggle-filters">
          #foreach($component in $components)##
            <li class="index" id="${component.id}_nav"><button onclick="toggle('$component.id')">$component.name</button></li>#end##
        </ul>



        <div id="changelog">
            #foreach($changelog in $changelogsSubset)
              <div class="title-wrapper">
                <h2>$changelogTitle $changelog.version</h2>
                <span class="release-date">$changelog.date</span>
              </div>
              #foreach($component in $components)##
                <section id="${changelog.version}_${component.id}" class="component_${component.id}">
                  <h4>$component.name $changelog.getComponentVersion($component)</h4>
                  #if($changelog.hasChangelogEntries($component))##
                    #foreach($entry in $changelog.getChangelogEntries($component))
                      #parse("partials/singleEntry.vm")
                    #end##
                  #else##
                    <div class="no-changes">
                      <span class="icon-no-changes"></span>
                      No changes
                    </div>
                  #end##
                </section>
              #end##
            #end##
      


          </section>
        </div>
      </main>
    </div>

    <aside class="right-panel" id="right-panel" data-title="Components">
    </aside>
  </div>
  <!-- /.layout-wrapper -->

  #parse("partials/footer.vm")
  <!-- Changelog Functionality -->
  <script src="../static/js/changelog.js"></script>
  
</body>

</html>
