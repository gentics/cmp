#set($changelog = $changelogsSubset.get(0))
#set($latestchangelog = $changelogsSubset.get(0))
#set($version = "$changelog.getVersion()")
#set($shortVersion = $version.substring(0, $version.lastIndexOf(".")))
#set($pageTitle = "$changelogTitle $shortVersion Changelog")
<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Gentics ActaNovaDialogPortal Changelog. Overview of all Releases for Version $shortVersion" />
  <meta http-equiv="cache-control" content="no-store, no-cache, must-revalidate, post-check=0, pre-check=0">
  <title>$pageTitle</title>

  <!-- Common Styles: Colors, Fonts, Header, Footer -->
  <link rel="stylesheet" href="https://www.gentics.com/static/css/common.css" />


  <!-- Changelog Specific Styles -->
  <link rel="stylesheet" href="../static/css/changelog.css" />
</head>

<body>
  #parse("partials/header.vm")

  <section class="hero-small">
    <div class="container">
      <h1>$pageTitle</h1>
    </div>
  </section>

  #parse("partials/mainnav.vm")

  #set($version = "$changelog.getVersion()")
  #set($shortVersion = $version.substring(0, $version.lastIndexOf(".")))
  <div id="nav-currentversion-submenu" data-majorversion="${shortVersion}" data-markactive="true">
    <ul class="nav-submenu"> 
       #foreach($subversion in $changelogsSubset)
          <li class="nav-item">
            <a href="./${subversion.version}.html" class="nav-link">
                $changelogTitle $subversion.version
            </a>
          </li>
        #end
    </ul>
  </div>

	
<!-- Main Layout Wrapper -->
  <div class="layout-wrapper">
    <!-- Hero Section -->
    <div class="main-content">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/infoportal" class="breadcrumb-link">
              Infoportal
            </a>
          </li>
          <li class="breadcrumb-item">
            <a href="/cmp/changelog" class="breadcrumb-link">CMP Changelogs</a>
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <a href="../${shortVersion}.0" class="breadcrumb-link">$changelogTitle $shortVersion</a>
          </li>
        </ol>
      </nav>	

      <!-- Main Content -->
      <main id="main-content">
        <div id="changelog" class="changelog-hub">
          <div class="title-wrapper">
            <div class="hub-header">
            <h2>$pageTitle</h2>
            <p>Stay updated with the latest improvements and fixes.</p>
            </div>
            <a class="btn-view-summary" href="merged_changelog.html">
            View Full Summary
            </a>
          </div>

          <section class="latest-release-wrapper">
            <a href="${latestchangelog.version}.html" class="version-card latest">
            <div class="card-content">
              <span class="badge-latest">Latest Release</span>
              <span class="version-number">$changelogTitle $latestchangelog.version</span>
              <span class="version-date">$latestchangelog.date</span>
            </div>
            <div class="version-arrow">→</div>
            </a>
          </section>

          <h4 class="previous-versions-title">Previous Versions</h4>

          
          #if($changelogsSubset.size() > 1)
            <section class="versions-list">
              #set($skipFirst=true)
              #foreach($changelog in $changelogsSubset)##
                #if($skipFirst == true)
                  #set($skipFirst=false)
                #else##
                  #set($unreleased = false)
                  #set($unreleased = $changelog.getGenericProperties().get("unreleased"))##
                  #if($unreleased)##
                    #set($info = "(Unreleased)")##
                  #else
                    #set($info = "")##
                  #end
                  <a href="${changelog.version}.html" class="version-list-item">
                  <span class="version-number">$changelogTitle $changelog.version $info</span>
                  <span class="version-date">$changelog.date</span>
                  <span class="version-arrow">→</span>
                #end##
              #end##
              </a>
            </section>
          #end##
        </div>
      </main>
    </div>


	  <aside class="right-panel" id="right-panel">
    </aside>
  </div>
  <!-- /.layout-wrapper -->
  #parse("partials/footer.vm")
  <!-- Changelog Functionality -->
  <script src="../static/js/changelog.js"></script>
</body>

</html>