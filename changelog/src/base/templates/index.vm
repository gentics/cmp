#set($pageTitle = "$changelogTitle Changelog")
<!doctype html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description"
    content="Gentics CMP Changelog. View all changes and bugfixes in a specific CMP Version" />
  <meta http-equiv="cache-control" content="no-store, no-cache, must-revalidate, post-check=0, pre-check=0">
  <title>$pageTitle</title>

  <!-- Common Styles: Colors, Fonts, Header, Footer -->
  <link rel="stylesheet" href="https://www.gentics.com/static/css/common.css" />


  <!-- Changelog Specific Styles -->
  <link rel="stylesheet" href="./static/css/changelog.css" />
</head>

<body>
  #parse("partials/header.vm")

  <section class="hero-small">
    <div class="container">
      <h1>$pageTitle</h1>
    </div>
  </section>

  #parse("partials/mainnav.vm")



	
<!-- Main Layout Wrapper -->
  <div class="layout-wrapper">
    <!-- Hero Section -->
    <div class="main-content">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li class="breadcrumb-item">
            <a href="/infoportal" class="breadcrumb-link">
              Infoportal
            </a>
          </li>
          <li class="breadcrumb-item active" aria-current="page">
            <a href="/cmp/changelog" class="breadcrumb-link">CMP Changelogs</a>
          </li>
        </ol>
      </nav>	

      <!-- Main Content -->
      <main id="main-content">
        <div id="changelog" class="changelog-hub">
          <div class="title-wrapper">
            <div class="hub-header">
              <h2>$changelogTitle Feature Releases</h2>
              <p>Explore the evolution of our platform through major releases and milestones.</p>
            </div>
          </div>

          <div class="timeline-container">

            #foreach($entry in $minorVersions.keySet())
              <div class="timeline-entry">
                <div class="timeline-marker"></div>
                <div class="timeline-content">
                  <div class="timeline-date">Date</div>
                  <div class="timeline-card">
                    <div class="timeline-image-placeholder gradient-variant-1">
                        <span>$changelogTitle $entry</span>
                    </div>
                    <div class="timeline-body">
                        <h3>$changelogTitle $entry</h3>
                        <p></p>
                        <a href="${entry}/" class="btn-read-more">View 8.4.x Changelogs →</a>
                    </div>
                  </div>
                </div>
              </div>
            #end
          </div>
        </div>
      </main>
    </div>


	  <aside class="right-panel" id="right-panel">
    </aside>
  </div>
  <!-- /.layout-wrapper -->
  #parse("partials/footer.vm")

  <!-- Changelog Functionality -->
  <script src="./static/js/changelog.js"></script>
</body>

</html>