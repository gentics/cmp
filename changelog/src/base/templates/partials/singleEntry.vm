<article id="$!{anchorTarget}" class="changelog-entry $!{entry.type}">
<header class="entry-header">
    <span class="icon icon-$!{entry.type}"></span>
    <div class="entry-header-content">
    <h5 class="entry-title">
        $!{elemTitle}
        <button class="copy-link-btn" data-link-target="#$!{anchorTarget}" aria-label="Copy link to this entry">
        <span class="icon icon-link"></span>
        </button>
    </h5>
    <span class="entry-type $!{entry.type}">$!{labelTitle}</span>
    </div>
</header>
<div class="entry-content">
    $html
</div>
</article>