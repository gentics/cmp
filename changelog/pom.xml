<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.gentics.cmp</groupId>
		<artifactId>cmp</artifactId>
		<version>8.1.38-SNAPSHOT</version>
	</parent>

	<artifactId>cmp-changelog</artifactId>
	<packaging>pom</packaging>
	<description>Module for building the combined changelog including the dependency report.</description>

    <dependencies>
		<!-- Gentics CMS OSS -->
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-oss-server</artifactId>
			<version>${cms-oss.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-aloha-plugins</artifactId>
			<version>${cms-oss.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-js-lib</artifactId>
			<version>${cms-oss.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms-oss</groupId>
			<artifactId>cms-ui</artifactId>
			<version>${cms-oss.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>

		<!-- Gentics CMS EE -->
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-changelog</artifactId>
			<version>${cms.version}</version>
			<type>zip</type>
			<classifier>entries</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.cms</groupId>
			<artifactId>cms-server</artifactId>
			<version>${cms.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>

		<!-- Gentics Aloha Editor -->
		<dependency>
			<groupId>org.alohaeditor</groupId>
			<artifactId>alohaeditor</artifactId>
			<version>${aloha.version}</version>
			<type>zip</type>
			<classifier>changelog-entries</classifier>
		</dependency>
		<dependency>
			<groupId>org.alohaeditor</groupId>
			<artifactId>alohaeditor</artifactId>
			<version>${aloha.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>

		<!-- Gentics Mesh -->
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>mesh-changelog</artifactId>
			<version>${mesh.version}</version>
			<type>zip</type>
			<classifier>entries</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh</groupId>
			<artifactId>mesh-server</artifactId>
			<version>${mesh.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>

		<!-- Gentics Mesh SQL -->
		<dependency>
			<groupId>com.gentics.mesh.enterprise</groupId>
			<artifactId>mesh-enterprise-changelog</artifactId>
			<version>${meshsql.version}</version>
			<type>zip</type>
			<classifier>entries</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.enterprise</groupId>
			<artifactId>mesh-enterprise-server</artifactId>
			<version>${meshsql.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>

		<!-- Gentics Mesh Commercial Plugins -->
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-commercial-plugins-changelog</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>entries</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-comment-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-export-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-favorite-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-forms-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-gcms-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-keycloak-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-like-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-mustread-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.plugin.commercial</groupId>
			<artifactId>mesh-search-plugin</artifactId>
			<version>${mesh.plugins.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>

		<!-- Gentics Portal | java -->
		<dependency>
			<groupId>com.gentics.mesh.portal</groupId>
			<artifactId>mesh-portal-changelog</artifactId>
			<version>${portal.java.version}</version>
			<type>zip</type>
			<classifier>entries</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.portal</groupId>
			<artifactId>mesh-portal-server</artifactId>
			<version>${portal.java.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>

		<!-- Gentics Portal | php -->
		<dependency>
			<groupId>com.gentics.mesh.portal-php</groupId>
			<artifactId>mesh-portal-php-changelog</artifactId>
			<version>${portal.php.version}</version>
			<type>zip</type>
			<classifier>entries</classifier>
		</dependency>
		<dependency>
			<groupId>com.gentics.mesh.portal-php</groupId>
			<artifactId>mesh-portal-php-dependencies</artifactId>
			<version>${portal.php.version}</version>
			<type>zip</type>
			<classifier>dependency-report</classifier>
		</dependency>
	</dependencies>

	<build>
		<plugins>
            <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>unpack-changelogs</id>
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<!-- Gentics CMS EE -->
								<artifactItem>
									<groupId>com.gentics.cms</groupId>
									<artifactId>cms-changelog</artifactId>
									<type>zip</type>
									<classifier>entries</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/changelogs/cms/entries</outputDirectory>
								</artifactItem>

								<!-- Gentics Aloha Editor -->
								<artifactItem>
									<groupId>org.alohaeditor</groupId>
									<artifactId>alohaeditor</artifactId>
									<type>zip</type>
									<classifier>changelog-entries</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/changelogs/aloha/entries</outputDirectory>
								</artifactItem>

								<!-- Gentics Mesh -->
								<artifactItem>
									<groupId>com.gentics.mesh</groupId>
									<artifactId>mesh-changelog</artifactId>
									<type>zip</type>
									<classifier>entries</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/changelogs/mesh/entries</outputDirectory>
								</artifactItem>

								<!-- Gentics Mesh SQL -->
								<artifactItem>
									<groupId>com.gentics.mesh.enterprise</groupId>
									<artifactId>mesh-enterprise-changelog</artifactId>
									<type>zip</type>
									<classifier>entries</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/changelogs/meshsql/entries</outputDirectory>
								</artifactItem>

								<!-- Gentics Mesh Commercial Plugins -->
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-commercial-plugins-changelog</artifactId>
									<type>zip</type>
									<classifier>entries</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/changelogs/meshplugins/entries</outputDirectory>
								</artifactItem>

								<!-- Gentics Portal | java -->
								<artifactItem>
									<groupId>com.gentics.mesh.portal</groupId>
									<artifactId>mesh-portal-changelog</artifactId>
									<type>zip</type>
									<classifier>entries</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/changelogs/portaljava/entries</outputDirectory>
								</artifactItem>

								<!-- Gentics Portal | php -->
								<artifactItem>
									<groupId>com.gentics.mesh.portal-php</groupId>
									<artifactId>mesh-portal-php-changelog</artifactId>
									<type>zip</type>
									<classifier>entries</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/changelogs/portalphp/entries</outputDirectory>
								</artifactItem>
							</artifactItems>
							<includes>**/*</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
					<execution>
						<id>unpack-dependency-reports</id>
						<phase>process-resources</phase>
						<goals>
							<goal>unpack</goal>
						</goals>
						<configuration>
							<artifactItems>
								<!-- Gentics CMS OSS -->
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-oss-server</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/cms-oss-server/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-aloha-plugins</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/cms-aloha-plugins/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-js-lib</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/cms-js-lib/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.cms-oss</groupId>
									<artifactId>cms-ui</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/cms-ui/</outputDirectory>
								</artifactItem>

								<!-- Gentics CMS EE -->
								<artifactItem>
									<groupId>com.gentics.cms</groupId>
									<artifactId>cms-server</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/cms-server/</outputDirectory>
								</artifactItem>

								<!-- Gentics Aloha Editor -->
								<artifactItem>
									<groupId>org.alohaeditor</groupId>
									<artifactId>alohaeditor</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/aloha/</outputDirectory>
								</artifactItem>

								<!-- Gentics Mesh -->
								<artifactItem>
									<groupId>com.gentics.mesh</groupId>
									<artifactId>mesh-server</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-server/</outputDirectory>
								</artifactItem>

								<!-- Gentics Mesh SQL -->
								<artifactItem>
									<groupId>com.gentics.mesh.enterprise</groupId>
									<artifactId>mesh-enterprise-server</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-enterprise-server/</outputDirectory>
								</artifactItem>

								<!-- Gentics Mesh Commercial Plugins -->
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-comment-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-comment-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-export-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-export-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-favorite-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-favorite-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-forms-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-forms-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-gcms-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-gcms-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-keycloak-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-keycloak-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-like-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-like-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-mustread-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-mustread-plugin/</outputDirectory>
								</artifactItem>
								<artifactItem>
									<groupId>com.gentics.mesh.plugin.commercial</groupId>
									<artifactId>mesh-search-plugin</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/mesh-search-plugin/</outputDirectory>
								</artifactItem>

								<!-- Gentics Portal | java -->
								<artifactItem>
									<groupId>com.gentics.mesh.portal</groupId>
									<artifactId>mesh-portal-server</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/portal-java/</outputDirectory>
								</artifactItem>

								<!-- Gentics Portal | php -->
								<artifactItem>
									<groupId>com.gentics.mesh.portal-php</groupId>
									<artifactId>mesh-portal-php-dependencies</artifactId>
									<type>zip</type>
									<classifier>dependency-report</classifier>
									<overWrite>true</overWrite>
									<outputDirectory>${project.build.directory}/reports/portal-php/</outputDirectory>
								</artifactItem>
							</artifactItems>
							<includes>**/*</includes>
							<overWriteReleases>false</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
            <plugin>
				<groupId>com.gentics</groupId>
				<artifactId>changelog-manager-plugin</artifactId>
				<version>${changelog.manager.plugin.version}</version>
                <executions>
					<execution>
						<goals>
							<goal>generate</goal>
						</goals>
						<phase>package</phase>
					</execution>
				</executions>
				<configuration>
					<baseDirectory>${basedir}/src/base</baseDirectory>
					<outputDirectory>${basedir}/target/output</outputDirectory>
					<changelogTitle>Gentics CMP</changelogTitle>
					<changelogTypes>manualchange,feature,enhancement,bugfix,documentation,optional-manualchange</changelogTypes>
					<changelogVersion>${changelog.version}</changelogVersion>
					<strictRenderMode>false</strictRenderMode>
					<allowEmptyChangelog>true</allowEmptyChangelog>
					<includeProjectProperties>false</includeProjectProperties>
					<overviewTemplateFiles>index.vm</overviewTemplateFiles>
					<perMajorVersionTemplateFiles>majorversion/index.vm,majorversion/merged_changelog.vm</perMajorVersionTemplateFiles>
					<perMajorVersionChangelogFile>majorversion/changelog.vm</perMajorVersionChangelogFile>
					<skipMapping>${skip.mapping}</skipMapping>
					<skipRender>${skip.render}</skipRender>
					<components>
						<!-- Gentics CMS EE -->
						<component>
							<id>cms</id>
							<name>Gentics CMS EE</name>
							<shortName>CMS</shortName>
							<version>${cms.changelog.version}</version>
							<entriesDirectory>${project.build.directory}/changelogs/cms/entries</entriesDirectory>
						</component>

						<!-- Gentics Aloha Editor -->
						<component>
							<id>aloha</id>
							<name>Gentics Aloha Editor</name>
							<shortName>Aloha Editor</shortName>
							<version>${aloha.changelog.version}</version>
							<entriesDirectory>${project.build.directory}/changelogs/aloha/entries</entriesDirectory>
						</component>

						<!-- Gentics Mesh -->
						<component>
							<id>mesh</id>
							<name>Gentics Mesh</name>
							<shortName>Mesh</shortName>
							<version>${mesh.changelog.version}</version>
							<entriesDirectory>${project.build.directory}/changelogs/mesh/entries</entriesDirectory>
						</component>

						<!-- Gentics Mesh SQL -->
						<component>
							<id>meshsql</id>
							<name>Gentics Mesh SQL</name>
							<shortName>Mesh SQL</shortName>
							<version>${meshsql.changelog.version}</version>
							<entriesDirectory>${project.build.directory}/changelogs/meshsql/entries</entriesDirectory>
						</component>

						<!-- Gentics Mesh Commercial Plugins -->
						<component>
							<id>meshplugins</id>
							<name>Gentics Mesh Commercial Plugins</name>
							<shortName>Plugins</shortName>
							<version>${mesh.plugins.changelog.version}</version>
							<entriesDirectory>${project.build.directory}/changelogs/meshplugins/entries</entriesDirectory>
						</component>

						<!-- Gentics Portal | java -->
						<component>
							<id>portaljava</id>
							<name>Gentics Portal | java</name>
							<shortName>Portal | java</shortName>
							<version>${portal.java.changelog.version}</version>
							<entriesDirectory>${project.build.directory}/changelogs/portaljava/entries</entriesDirectory>
						</component>

						<!-- Gentics Portal | php -->
						<component>
							<id>portalphp</id>
							<name>Gentics Portal | php</name>
							<shortName>Portal | php</shortName>
							<version>${portal.php.changelog.version}</version>
							<entriesDirectory>${project.build.directory}/changelogs/portalphp/entries</entriesDirectory>
						</component>
					</components>
				</configuration>
			</plugin>
			<plugin>
				<groupId>com.gentics</groupId>
				<artifactId>dependency-reporting-plugin</artifactId>
				<version>${dependency.reporting.plugin.version}</version>
				<executions>
					<execution>
						<id>render</id>
						<goals>
							<goal>render</goal>
						</goals>
						<configuration>
							<inputDirectory>${project.build.directory}/reports/</inputDirectory>
							<outputDirectory>${project.build.directory}/output</outputDirectory>
							<outputName>dependency-report.html</outputName>
							<templateFile>${project.basedir}/src/base/templates/dependency-report.vm</templateFile>
							<properties>
								<reportTimestamp>${maven.build.timestamp}</reportTimestamp>
							</properties>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>dist</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<attach>true</attach>
							<appendAssemblyId>false</appendAssemblyId>
							<descriptors>
								<descriptor>${project.basedir}/src/assembly/changelog-site-package.xml</descriptor>
							</descriptors>
						</configuration>
					</execution>
				</executions>
			</plugin>
        </plugins>
    </build>
</project>
