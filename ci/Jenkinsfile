@Library('jenkins-pipeline-library') import com.gentics.*

JobContext.set(this)

final def gitCommitTag         = '[Jenkins | ' + env.JOB_BASE_NAME + ']';
def tagName = null;
def version = null;

final def helmRepositoryProd   = 'https://repo.gentics.com/repository/helm/';
final def helmRepositoryTest   = 'https://repo.gentics.com/repository/helm-snapshots/';
def helmRepository = helmRepositoryTest;

def prependZeroIfNotDigitPrefixed(String ver) {
    return (ver ==~ /^[0-9].*/) ? ver : "0-" + ver
}

pipeline {
    agent {
        label 'docker'
    }

    parameters {
        booleanParam(name: 'skipMapping',         defaultValue: false, description: "Skip (re-)generation of mapping files.")
        booleanParam(name: 'runDeploy',           defaultValue: false, description: "Deploy the Maven and Helm artifacts.")
        booleanParam(name: 'runDeployTesting',    defaultValue: false, description: "Deploy the Maven and Helm artifacts to the snapshot repo.")
        booleanParam(name: 'release',             defaultValue: false, description: "Run a release build (this requires 'runDeploy').")
    }

    options {
        withCredentials([
            usernamePassword(credentialsId: 'docker.gentics.com', usernameVariable: 'repoUsername', passwordVariable: 'repoPassword'),
            usernamePassword(credentialsId: 'gentics.gpg', usernameVariable: 'gpgKeyName', passwordVariable: 'gpgKeyPass')
        ])
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        gitLabConnection('git.gentics.com')
        gitlabBuilds(builds: ['Jenkins build'])
        ansiColor('xterm')
    }

    environment {
        GITLAB_WEBHOOK_SECRETTOKEN = credentials('gitlab-webhook-secrettoken')
    }

    stages {
        stage("Build") {
            when {
                expression {
                    return !params.runDeployTesting
                }
            }
            steps {
                script {
                    currentBuild.description = env.GIT_COMMIT + "\n" + GitHelper.getLastCommitMessage().readLines()[0]
                }

                updateGitlabCommitStatus name: 'Jenkins build', state: "running"

                script {
                    def mvnGoal       = "install"
                    def mvnArguments  = ""
                    version = MavenHelper.getVersion()

                    if (params.runDeploy || params.runDeployTesting) {
                        mvnGoal = "deploy"

                        if (params.release) {
                            echo "Updating version " + version + " for release."
                            version = MavenHelper.transformSnapshotToReleaseVersion(version)

                            MavenHelper.setVersion(version)

                            def releaseMessage = 'Release of version ' + version

                            tagName = version
                            GitHelper.addCommit('.', gitCommitTag + ' ' + releaseMessage)
                            GitHelper.addTag(tagName, releaseMessage)

                            currentBuild.description = currentBuild.description + "\nRelease " + version
                        }

                        echo "Deploying version: " + version
                    }

                    if (params.skipMapping) {
                        mvnArguments = mvnArguments + ' -Dskip.mapping=true'
                    }

                    sh "JAVA_HOME=\$JAVA_1_11_HOME mvn -U -B -fae " + mvnArguments + " clean " + mvnGoal
                }
            }
        }

        stage("Build Helm Charts"){
            when {
                expression {
                    return params.runDeploy || params.runDeployTesting
                }
            }
            steps {
                script {
                    if (Boolean.valueOf(params.release)) {
                        helmRepository = helmRepositoryProd;
                    }

                    version = MavenHelper.getVersion()
                    def cmsVersion        = sh(script: "mvn help:evaluate -Dexpression=cms.version -q -DforceStdout", returnStdout: true).trim()
                    def meshVersion       = sh(script: "mvn help:evaluate -Dexpression=mesh.version -q -DforceStdout", returnStdout: true).trim()
                    def portalsVersion = sh(script: "mvn help:evaluate -Dexpression=portals.version -q -DforceStdout", returnStdout: true).trim()

                    echo "cms.version=${cmsVersion} mesh.version=${meshVersion} portals.version=${portalsVersion}"

                    def genticsCommonVersion = sh(
                        script: "docker run --rm -v \$(pwd):/apps -w /apps mikefarah/yq:4 eval '.version' ee/cmp-chart/charts/gentics-common/Chart.yaml",
                        returnStdout: true
                    ).trim()

                    def helmVersion = version
                    if (Boolean.valueOf(params.runDeployTesting)) {
                        cmsVersion = prependZeroIfNotDigitPrefixed(cmsVersion)
                        meshVersion = prependZeroIfNotDigitPrefixed(meshVersion)
                        portalsVersion = prependZeroIfNotDigitPrefixed(portalsVersion)
                        genticsCommonVersion = prependZeroIfNotDigitPrefixed(genticsCommonVersion)
                        helmVersion = prependZeroIfNotDigitPrefixed(helmVersion)
                    }

                    //Release gentics-common first - it's used in the cmp chart too
                    sh "ci/build-helm-chart.sh ${genticsCommonVersion} ee/cmp-chart/charts/gentics-common"

                    withCredentials([usernamePassword(credentialsId: 'docker.gentics.com', usernameVariable: 'repoUsername', passwordVariable: 'repoPassword')]) {
                        def genticsCommonPackageFilename = "gentics-common-${genticsCommonVersion}.tgz"
                        echo "Deploying gentics-common Helm Chart"
                        sh "curl -u ${repoUsername}:${repoPassword} ${helmRepository} --upload-file target/${genticsCommonPackageFilename}"
                    }

                    //update dependencies for cmp-sub-charts - use versions from pom.xml or test-version
                    sh "ci/set-chart-dependency-versions.sh ee/cmp-chart/Chart.yaml ${helmRepository} " +
                        "gentics-common=${genticsCommonVersion} " +
                        "cms=${cmsVersion} " +
                        "gentics-mesh=${meshVersion} " +
                        "gentics-portal-java=${portalsVersion} " +
                        "gentics-portal-php=${portalsVersion}"

                    withCredentials([usernamePassword(credentialsId: 'docker.gentics.com', usernameVariable: 'repoUsername', passwordVariable: 'repoPassword')]) {
                        sh 'REPO_USERNAME=$repoUsername REPO_PASSWORD=$repoPassword ci/update-helm-dependencies.sh ee/cmp-chart/'
                    }


                    sh "ci/build-helm-chart.sh ${helmVersion} ee/cmp-chart/"
                    

                    withCredentials([usernamePassword(credentialsId: 'docker.gentics.com', usernameVariable: 'repoUsername', passwordVariable: 'repoPassword')]) {
                        def packageFilename = "cmp-${helmVersion}.tgz"
                        echo "Deploying CMS Helm Chart"
                        sh "curl -u ${repoUsername}:${repoPassword} ${helmRepository} --upload-file target/${packageFilename}"
                    }
                }

            }
        }

        stage("Git push") {
            when {
                expression {
                    return params.runDeploy && params.release
                }
            }

            steps {
                script {
                    def newSnapshotVersion = MavenHelper.getNextSnapShotVersion()
                    MavenHelper.setVersion(newSnapshotVersion)

                    GitHelper.addCommit('.', gitCommitTag + ' Prepare for the next development iteration (' + newSnapshotVersion + ')' + '\n\n[ci-skip]')

                    sshagent(["git"]) {
                        def branchName = GitHelper.fetchCurrentBranchName()
                        GitHelper.pushBranch(branchName)

                        if (tagName != null) {
                            GitHelper.pushTag(tagName)
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            updateGitlabCommitCurrentBuildStatus name: 'Jenkins build'
        }
    }
}
