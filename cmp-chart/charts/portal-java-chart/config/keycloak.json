{
    "realm": "{{ .Values.keycloak.realmName }}",
    "auth-server-url": "{{ .Values.keycloak.authUrl }}",
    "ssl-required": "external",
    "resource": "{{ .Values.keycloak.clientName }}",
    "public-client": {{ .Values.keycloak.publicClient }},
    {{- if not .Values.keycloak.publicClient }}
    "credentials": {
        "secret": "{{ .Values.keycloak.clientSecret }}"
    },
    {{- end }}
    "confidential-port": 0,
    "realm-public-key": "{{ required "A realm public key is required. You can download the key via https://your.keycloak/auth/realms/YOUR_REALM" .Values.keycloak.realmPublicKey }}"
  }
